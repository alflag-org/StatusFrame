{
  "name": "@statusframe/worker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc --test-scheduled",
    "deploy": "pnpm db:remote && wrangler deploy --config ../../wrangler.jsonc",
    "deploy:check": "wrangler deploy --config ../../wrangler.jsonc --dry-run --outdir ../../dist/worker",
    "db:local": "wrangler d1 migrations apply STATUSFRAME_DB --config ../../wrangler.jsonc --local",
    "db:remote": "wrangler d1 migrations apply STATUSFRAME_DB --config ../../wrangler.jsonc --remote"
  },
  "dependencies": {
    "@statusframe/core": "workspace:*",
    "@statusframe/monitors": "workspace:*",
    "@statusframe/notifications": "workspace:*"
  }
}
