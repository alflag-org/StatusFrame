{
  "name": "statusframe",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "build": "pnpm typecheck && pnpm test",
    "deploy": "pnpm --filter @statusframe/worker run deploy",
    "dev": "pnpm --filter @statusframe/worker dev",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm build && pnpm test:integration && pnpm --filter @statusframe/worker deploy:check"
  },
  "dependencies": {
    "yaml": "^2.8.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^24.10.1",
    "miniflare": "^4.20260611.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wrangler": "^4.146.0",
    "esbuild": "^0.27.0"
  }
}
